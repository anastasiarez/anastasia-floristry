# Contact form email delivery.
#
# Both of these are injected automatically by the Vercel Resend integration
# (Integrations > Resend). You do NOT need to set them by hand in Vercel.
# This file exists so local development can send mail too: copy it to .env
# and paste the values from the Vercel dashboard.
#
# NOTE: .env is gitignored and never reaches Vercel. Setting values here has
# no effect on the deployed site.
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=anastasiafloristry.com

# Optional. Overrides the derived sender entirely. Leave unset and the app
# builds it as "<site name> <hello@RESEND_EMAIL_DOMAIN>".
# RESEND_FROM="Anastasia Floristry <hello@anastasiafloristry.com>"
